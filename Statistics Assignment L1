# Hypothesis 6: Can chromosome size predict gene counts? > Model fitting and chi-square goodness-of-fit

# preparing necessary variables for testing
total_genes <- sum(autosomes_data$Gene)
total_size <- sum(autosomes_data$Size_.Mb.)
size_probability <- autosomes_data$Size_.Mb. / total_size
observed_genes <- autosomes_data$Gene


# Statistical testing

# Chi-square goodness-of-fit test
chi_test <- chisq.test(x = observed_genes, p = size_probability)
chi_test

# comparing observed genes and expected counts
model_6 <- data.frame(
  Chromosome = as.character(autosomes_data$Name),
  Size_Mb = autosomes_data$Size_.Mb.,
  Observed = observed_genes,
  Expected = chi_test$expected,
  Residual = observed_genes - chi_test$expected,
  Standardized_Residual = chi_test$stdres,
  Enrichment = observed_genes / chi_test$expected) %>%
  mutate(across(c(Expected, Residual,Standardized_Residual, Enrichment),~round(.x, 3)))
model_6



# The residual (and the standardized residual) of chromosome 19 is suupper high, meaning it might influence the regression
# let me examine the influential of chromosome 19
# adding Cook's distance --> Measures how strongly an observation influences the fitted model, regardless of the direction of its residual.

influence_results <- autosomes_data %>%
  mutate(
    Predicted = predict(model_4_adjusted),
    Residual = residuals(model_4_adjusted),
    Studentized_Residual = rstudent(model_4_adjusted),
    Cooks_Distance = cooks.distance(model_4_adjusted)) %>%
  dplyr::select(Name, Gene_Density, Predicted, Residual, Studentized_Residual,Cooks_Distance)

