  mutate(
    Gene = as.numeric(gsub("-", "0", gsub(",", "", as.character(Gene)))),
    Pseudogene = as.numeric(gsub("-", "0", gsub(",", "", as.character(Pseudogene)))),
    Protein = as.numeric(gsub("-", "0", gsub(",", "", as.character(Protein)))),
