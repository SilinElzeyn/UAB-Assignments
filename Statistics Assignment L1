ensembl_summary <- data.frame(
  Species = c("Human", "Mouse"),
  Assembly = c("GRCh38.p14", "GRCm39"),
  Coding_Genes = c(20543, 22311),
  NonCoding_Genes = c(42155, 38999),
  Pseudogenes = c(15205, 13819),
  Assembly_Unit = c(25, 22),
  Homology_Coverage = c(91.3, 83.0),
  Short_Variants = c(1173667712, 118762680),
  Enhancers = c(246403, 161385),
  Promoters = c(35983, 31408)
)

ensembl_summary


# Now: I will compare the correlation of each 

ensembl_comparison <- ensembl_summary %>%
  dplyr::select(Species, Coding_Genes, NonCoding_Genes, Pseudogenes, Homology_Coverage, Short_Variants, Enhancers, Promoters) %>%
  pivot_longer(cols = -Species, names_to = "Variable", values_to = "Value") %>%
  pivot_wider(names_from = Species, values_from = Value) %>%
  mutate(Difference = Human - Mouse,Ratio_Human_Mouse = Human / Mouse)

ensembl_comparison
kable(ensembl_comparison)


# Visualization

plot_data <- ensembl_comparison %>% dplyr::select(Variable, Human, Mouse) %>%
  pivot_longer(cols = c(Human, Mouse), names_to = "Species", values_to = "Value")

# Visualize all variables
ggplot(plot_data, aes(x = Species, y = Value, fill = Species)) +
  geom_col(width = 0.6) +
  geom_text(aes(label = scales::comma(Value)), vjust = -0.4, size = 3) +
  facet_wrap(~Variable, scales = "free_y", ncol = 2) +
  scale_y_continuous(labels = scales::label_number(scale_cut = scales::cut_short_scale()), expand = expansion(mult = c(0, 0.18))) +
  labs(
    title = "Comparative Genomics: Human vs Mouse",
    subtitle = "Ensembl genome-level summary",
    x = NULL,
    y = "Value") +
  theme_minimal() +
  theme(legend.position = "none")


