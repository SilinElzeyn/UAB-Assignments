# HYPOTHESIS TESTING:  formulation and testing: explanation in the submitted report (using the autosomes data)
# I will test these hypotheses along with displaying the visual graphical representation

alpha <- 0.05

# ----------------------------------------------------------------------------------------------------
# Hypothesis 1: Does chromosome size "correlate" with absolute genomic annotation counts > correlation
# genomic annotation counts (gene, pseudogenes, protein coding, noncoding RNA)

# Statistical testing

count_variables <- c("Gene", "Pseudogene", "Protein", "Total_NonCoding_RNA")

correlation_results_1 <- list()

for (variable in count_variables) {
  
  test <- cor.test(autosomes_data$Size_.Mb., autosomes_data[[variable]], method = "pearson")
  
  correlation_results_1[[variable]] <- data.frame(
    Variable = variable,
    Correlation = unname(test$estimate),
    T_statistic = unname(test$statistic),
    P_value = test$p.value,
    CI_Lower = test$conf.int[1],
    CI_Upper = test$conf.int[2]
  )
}

results_1 <- bind_rows(correlation_results_1) %>%
  mutate(
    Correlation = round(Correlation, 3),
    T_statistic = round(T_statistic, 3),
    P_value = signif(P_value, 3),
    Significant = P_value < alpha
  )

correlation_results_1
kable(results_1)
