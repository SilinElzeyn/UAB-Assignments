# Further investigating the values that are considered outliers within the datasets
# with the following table I will be able to clearly identify with numbers exactly which chromosome hold a value that is high or low
# and based on the results I will be able to compare chromosomes within some groups and come up with questions to test statistically

# 1: Chromosome groups
groups <- list(Overall = cleaned_genome_data, Nuclear = nuclear_data, Autosomes = autosomes_data)

# 2: Identify all numerical genomic variables
variables <- names(cleaned_genome_data)[sapply(cleaned_genome_data, is.numeric)]

# 3: Loop through each group
outlier_results <- list()
for (group_name in names(groups)) {data <- groups[[group_name]]

# Loop through every numerical variable only
for (variable in variables) {values <- data[[variable]]

# Calculate quartiles and IQR
Q1 <- quantile(values, 0.25, na.rm = TRUE)
Q3 <- quantile(values, 0.75, na.rm = TRUE)

IQR_value <- Q3 - Q1

lower <- Q1 - 1.5 * IQR_value
upper <- Q3 + 1.5 * IQR_value

# Find chromosomes outside the limits
outliers <- which(values < lower | values > upper)

# Store the results if outliers exist into a data frame for easier table creation
if (length(outliers) > 0) {
  
  outlier_results[[length(outlier_results) + 1]] <- data.frame(
    Group = group_name,
    Variable = variable,
    Lower_Limit = as.numeric(lower),
    Upper_Limit = as.numeric(upper),
    Chromosome = data$Name[outliers],
    Value = values[outliers]
  )
}
}
}

# 4: Table
outlier_table <- dplyr::bind_rows(outlier_results)
outlier_table
View(outlier_table)


